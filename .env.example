NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Origin used for permanent /recover/:id links and provider callbacks.
# Use the current public HTTPS tunnel/host for real Test Mode and WhatsApp.
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/payarc.db
# Required in production; optional for local UI use.
OPERATOR_API_TOKEN=

# mock (default) or razorpay. Razorpay mode refuses non-test keys.
PAYMENT_PROVIDER_MODE=mock
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Optional during webhook-secret rotation.
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# AUTO_ACTIONS schedules/advances eligible work. EXTERNAL_ACTIONS is the
# separate provider-mutation gate; policy still bounds every execution.
AUTO_ACTIONS_ENABLED=true
EXTERNAL_ACTIONS_ENABLED=false
GLOBAL_KILL_SWITCH=false
MAX_AUTO_AMOUNT_PAISE=500000
MAX_CONTACTS_PER_CASE=3
MAX_CONTACTS_PER_CUSTOMER=3
CUSTOMER_CONTACT_WINDOW_SECONDS=604800
CONTACT_COOLDOWN_SECONDS=86400
PAYMENT_LINK_TTL_SECONDS=172800
CONTROL_COHORT_PERCENT=10
ALLOWED_CURRENCIES=INR
WORKER_BATCH_SIZE=200
WORKER_CONCURRENCY=10
WORKER_INTERVAL_MS=500
ACTION_RETRY_MAX_ATTEMPTS=3
ACTION_RETRY_BASE_SECONDS=30
ACTION_RETRY_MAX_SECONDS=900

# AI_PROVIDER: auto prefers Groq, then OpenAI, then deterministic fallback.
# Groq's free-plan gpt-oss model supports strict structured outputs.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional paid alternative.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# click_to_chat works without credentials and opens a consented pre-filled chat.
# cloud_api sends an approved utility template using Meta's WhatsApp Business Platform.
WHATSAPP_MODE=click_to_chat
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_TEMPLATE_NAME=recovery_payment_link
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Cloud API sends automatically. Click-to-chat prepares the message automatically.
WHATSAPP_AUTO_SEND_ENABLED=true
# Write this note when creating the Razorpay Order after explicit checkout opt-in.
WHATSAPP_CONSENT_NOTE_KEY=payarc_whatsapp_opt_in
# Configure Meta callback as ${PUBLIC_BASE_URL}/webhooks/whatsapp.
# The verify token handles the GET challenge; app secret verifies POST bodies.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
