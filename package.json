{
  "name": "payarc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-trust AI revenue recovery for Razorpay Test Mode",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:ui && npm run typecheck",
    "build:ui": "vite build --config frontend/vite.config.ts",
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-concurrency=1 tests/**/*.test.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "smoke:razorpay": "tsx scripts/razorpay-smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
